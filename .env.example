# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
#
# Without these three, viewing requests are printed to the terminal in
# development and fail loudly in production. See app/actions/reservations.ts.

# https://resend.com → API Keys. Server-side only: no NEXT_PUBLIC_ prefix, or
# it would be inlined into the browser bundle for anyone to read.
RESEND_API_KEY=

# Where viewing requests land. The agency's inbox.
RESERVATIONS_TO=reservations@example.cm

# The From address. Must be on a domain verified in Resend, otherwise the send
# is rejected. Not the visitor's address — their email becomes the Reply-To.
RESERVATIONS_FROM=Odza <reservations@example.cm>
