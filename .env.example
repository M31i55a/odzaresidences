# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
#
# Without these three, reservations are printed to the terminal in development
# and fail loudly in production. See app/actions/reservations.ts.
#
# No payment provider yet: a reservation quotes the amount and mails it, and
# the money is arranged with the customer afterwards. The provider's keys go
# here too when that step lands.

# Brevo dashboard → SMTP & API → API Keys, a v3 key. Server-side only: no
# NEXT_PUBLIC_ prefix, or it would be inlined into the browser bundle for
# anyone to read.
BREVO_API_KEY=

# Where reservations land. The agency's inbox.
RESERVATIONS_TO=reservations@example.cm

# The From address, as `Name <address>`. The address must be a validated
# sender in Brevo (or on a domain authenticated there), otherwise the send is
# rejected. Not the visitor's address — theirs becomes the Reply-To.
RESERVATIONS_FROM=Odza <reservations@example.cm>
