# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
# THIS FILE IS TRACKED AND PUSHED TO GITHUB: placeholders only, never a real
# key. GitHub's push protection will block the push if you slip one in here.
#
# Without the mail settings, reservations are printed to the terminal in
# development and fail loudly in production. See app/actions/reservations.ts.

# ---------------- mail (Brevo) ----------------

# Brevo dashboard → SMTP & API → API Keys, a v3 key. Server-side only: no
# NEXT_PUBLIC_ prefix, or it would be inlined into the browser bundle for
# anyone to read.
BREVO_API_KEY=

# Where reservations land. The agency's inbox.
RESERVATIONS_TO=reservations@example.cm

# The From address, as `Name <address>`. The address must be a validated
# sender in Brevo (or on a domain authenticated there), otherwise the send is
# rejected. Not the visitor's address — theirs becomes the Reply-To.
RESERVATIONS_FROM=Odza <reservations@example.cm>

# ---------------- payment (Paymooney) ----------------
#
# From the merchant dashboard: Liste projet -> Modifier. Without these the
# reservation still goes through and the confirmation screen falls back to
# settling by phone.
#
# Set these THREE URLs on the project in Paymooney's dashboard — they are
# project settings, not request parameters, so the code cannot supply them:
#
#   success url  https://YOURSITE/reservation/paid
#   cancel url   https://YOURSITE/reservation/cancelled
#   notify url   https://YOURSITE/api/paymooney/notify
#
# The notify URL must be reachable from the public internet. For local work,
# tunnel it (ngrok, or https://webhook.site as their docs suggest).

# Identifies the project on the payment request. Safe to be seen.
PAYMOONEY_PUBLIC_KEY=

# Signs their payment callbacks. Secret — this is what proves a callback is
# genuinely theirs. See app/api/paymooney/notify/route.ts.
PAYMOONEY_PRIVATE_KEY=

# `test` puts payments in test mode. ANY other value — including "live", and
# including leaving it empty — means real money. Their API treats the mere
# presence of the parameter as test mode, so the code only sends it when this
# reads exactly `test`.
#
# Note: card and PayPal have sandboxes, Orange Money does NOT. Paymooney's
# docs are explicit that Orange Money can only be tested in production.
PAYMOONEY_MODE=test

# TEST MODE ONLY — ignored unless PAYMOONEY_MODE is exactly `test`.
#
# A stay is billed in XAF, and XAF reaches Orange Money alone: card and PayPal
# take USD, CAD or EUR only. Since Orange Money has no test data, testing at
# all means billing a currency a test card can pay. These two say which, and
# how much, so the whole path can be exercised for a token amount.
#
# Test cards on the payment page (any future expiry, any CVC):
#   4242 4242 4242 4242  succeeds
#   4000 0000 0000 3063  asks for 3-D Secure first
#   4000 0000 0000 0069  declined, card expired
#   4000 0000 0000 0127  declined, wrong CVC
PAYMOONEY_TEST_CURRENCY=EUR
PAYMOONEY_TEST_AMOUNT=1

# ---------------- database (Neon) ----------------
#
# Vercel dashboard → Storage → Marketplace → Neon, then connect it to this
# project. Vercel Postgres was retired; Neon is its direct successor and was
# always what ran underneath it.
#
# Create the tables once:  psql "$DATABASE_URL" -f db/schema.sql
# Load the shipped listings: psql "$DATABASE_URL" -f db/seed.sql
#
# Locally, `vercel env pull` writes this for you.
DATABASE_URL=

# ---------------- image uploads (Vercel Blob) ----------------
#
# Vercel dashboard → Storage → Blob. On Vercel the SDK authenticates over OIDC
# automatically; this long-lived token is what makes uploads work OFF Vercel,
# and it is required for signing browser upload tokens.
BLOB_READ_WRITE_TOKEN=

# ---------------- admin ----------------
#
# One shared account, no user table — the simplest thing that locks the door.
# BOTH are required in production; without them /admin refuses to open at all.
# Changing either one signs everybody out immediately.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OPTIONAL. Signs the admin session cookie. Leave it empty and a key is
# derived from the email and password above, which keeps deployment to two
# variables — the signing key is then exactly as strong as the password you
# chose. Set an explicit one for anything beyond a demo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
